    {
      "parameters": {
        "jsCode": "// 1. Obtener la disponibilidad propuesta (viene del nodo de disponibilidad)\nconst dispo = $(\"Get row(s) in sheet\").first().json; \nconst hora_inicio_nueva = dispo.hora_inicio;\nconst hora_fin_nueva = dispo.hora_fin;\n\n// 2. Obtener datos del estudiante y tutor del nodo de emparejamiento anterior\nconst datosBase = $(\"Code in JavaScript\").first().json;\nconst id_estudiante = datosBase.id_estudiante;\nconst id_tutor = datosBase.id_tutor;\nconst nombre_tutor = datosBase.nombre_tutor;\nconst materia = datosBase.materia;\n\n// 3. Calcular la fecha propuesta del agendamiento (Próximo Lunes) en formato de TEXTO plano \"YYYY-MM-DD\"\nconst proximoLunes = new Date(Date.now() + ((8 - new Date().getDay()) % 7 || 7) * 24 * 3600 * 1000);\n// ¡SOLUCIONADO! .at(0) extrae únicamente el string \"2026-09-07\" y evita que se borre el corchete\nconst fecha_nueva = proximoLunes.toISOString().split('T').at(0); \n\n// 4. Obtener todas las tutorías registradas de la base de datos\nconst todasLasTutorias = $input.all();\n\n// Función auxiliar para convertir \"HH:MM\" a minutos totales transcurridos en el día\nfunction stringAMinutos(timeStr) {\n  if (!timeStr) return 0;\n  const partes = timeStr.split(':');\n  const hora = parseInt(partes.at(0), 10); // ¡SOLUCIONADO! Acceso seguro al índice 0\n  const minutos = parseInt(partes.at(1), 10); // ¡SOLUCIONADO! Acceso seguro al índice 1 (minutos reales)\n  return (hora * 60) + minutos; // Retorna minutos reales y limpios\n}\n\nconst t_inicio_nuevo = stringAMinutos(hora_inicio_nueva);\nconst t_fin_nuevo = stringAMinutos(hora_fin_nueva);\n\nlet cruceTutor = false;\nlet cruceEstudiante = false;\nlet codigo_conflicto = null;\n\n// 5. Validar cruces en la base de datos\ntodasLasTutorias.forEach(row => {\n  const t = row.json;\n  \n  // Solo validamos registros activos (\"Asignada\")\n  if (t.estado && t.estado.toLowerCase() === \"asignada\") {\n    \n    // Limpiamos y formateamos la fecha del registro a un simple String \"YYYY-MM-DD\"\n    let fechaRegistro = t.fecha;\n    \n    if (fechaRegistro) {\n      if (typeof fechaRegistro === 'string' && fechaRegistro.startsWith(\"[\")) {\n        try {\n          const arr = JSON.parse(fechaRegistro);\n          if (Array.isArray(arr) && arr.length > 0) {\n            fechaRegistro = arr.at(0); // ¡SOLUCIONADO! Extrae de forma segura el elemento 0 sin corchetes\n          }\n        } catch(e) {}\n      }\n      \n      // Si el formato contiene \"T\" (ej: ISO completo de n8n), nos quedamos solo con la fecha\n      if (typeof fechaRegistro === 'string' && fechaRegistro.includes(\"T\")) {\n        fechaRegistro = fechaRegistro.split('T').at(0);\n      }\n    }\n\n    // Comparación estricta de textos planos: \"2026-09-07\" === \"2026-09-07\"\n    if (fechaRegistro === fecha_nueva) {\n      const t_inicio_reg = stringAMinutos(t.hora_inicio);\n      const t_fin_reg = stringAMinutos(t.hora_fin);\n\n      // Evaluación de solapamiento matemático: (InicioA < FinB) && (FinA > InicioB)\n      const haySolapamiento = (t_inicio_nuevo < t_fin_reg) && (t_fin_nuevo > t_inicio_reg);\n\n      if (haySolapamiento) {\n        // ¿Es el mismo tutor el que estaría ocupado?\n        if (t.id_tutor.toString() === id_tutor.toString()) {\n          cruceTutor = true;\n          codigo_conflicto = t.id_tutoria;\n        }\n        // ¿Es el mismo estudiante el que se traslapa?\n        if (t.id_estudiante.toString() === id_estudiante.toString()) {\n          cruceEstudiante = true;\n          codigo_conflicto = t.id_tutoria;\n        }\n      }\n    }\n  }\n});\n\nconst hayDuplicidad = cruceTutor || cruceEstudiante;\n\nreturn [{\n  json: {\n    hay_duplicidad: hayDuplicidad,\n    tipo_error: cruceTutor ? \"tutor_ocupado\" : (cruceEstudiante ? \"estudiante_ocupado\" : \"ninguno\"),\n    id_estudiante: id_estudiante,\n    id_tutor: id_tutor,\n    nombre_tutor: nombre_tutor,\n    materia: materia,\n    fecha: fecha_nueva,\n    hora_inicio: hora_inicio_nueva,\n    hora_fin: hora_fin_nueva,\n    codigo_conflicto: codigo_conflicto\n  }\n}];"
      },
