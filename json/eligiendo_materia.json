    {
      "parameters": {
        "jsCode": "// 1. Obtener la lista de tutores que viene del nodo anterior (Google Sheets - tutores)\nconst tutores = $input.all();\n\n// 2. Obtener los datos del estudiante que ingresaron al inicio del sub-workflow\n// Usamos el nombre exacto de tu primer nodo: \"When Executed by Another Workflow\"\nconst triggerData = $(\"When Executed by Another Workflow\").first().json;\nconst idUsuario = triggerData.id_usuario; // El ID de Telegram del estudiante\nconst textoSeleccionado = triggerData.texto; // El número de opción (ej. \"1\", \"2\" o \"3\")\n\n// 3. Convertir la selección a un índice de lista (1 -> 0, 2 -> 1, 3 -> 2)\nconst seleccion = parseInt(textoSeleccionado);\nconst index = seleccion - 1;\n\n// 4. Validar que la selección del estudiante sea una opción válida en la lista\nif (isNaN(seleccion) || index < 0 || index >= tutores.length) {\n  throw new Error(`La opción seleccionada \"${textoSeleccionado}\" no corresponde a ninguna materia disponible.`);\n}\n\n// 5. Extraer los datos del tutor seleccionado según el índice\nconst tutorSeleccionado = tutores[index].json;\n\n// 6. Retornar los datos limpios para los siguientes nodos\nreturn [{\n  json: {\n    id_estudiante: idUsuario,\n    id_tutor: tutorSeleccionado.id_tutor,\n    nombre_tutor: tutorSeleccionado.nombre,\n    materia: tutorSeleccionado.materia,\n    estado_tutor: tutorSeleccionado.estado\n  }\n}];"
      },
