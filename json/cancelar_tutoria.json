    {
      "parameters": {
        "jsCode": "// 1. Capturamos los datos de la base de datos que entran desde Google Sheets y del Trigger\nconst tutorias = $input.all();\nconst triggerData = $(\"When Executed by Another Workflow\").first().json;\nconst idUsuario = triggerData.id_usuario;\n\n// 2. Filtramos únicamente las tutorías asignadas al estudiante actual que estén activas\n// Usamos .toString() para evitar colisiones si un ID viene como número y otro como texto\nconst activas = tutorias.filter(t => \n  t.json.id_estudiante && t.json.id_estudiante.toString() === idUsuario.toString() && t.json.estado === \"Asignada\"\n);\n\nlet mensaje = \"\";\n\nif (activas.length === 0) {\n  mensaje = \"📭 *No tienes tutorías activas para cancelar en este momento.*\";\n} else {\n  mensaje = \"❌ *CANCELACIÓN DE TUTORÍAS*\\n\\nEstas son tus tutorías programadas. Por favor, *escribe el código de referencia* (ej: `TUT-9001`) de la tutoría que deseas cancelar:\\n\\n\";\n\n  activas.forEach((tut, index) => {\n    // ¡SIMPLIFICADO! Tomamos la fecha limpia directamente del JSON sin procesarla ni alterarla\n    const fechaLimpia = tut.json.fecha;\n\n    // Construcción limpia y segura usando comillas invertidas (backticks) sin errores de sintaxis\n    mensaje += `📌 *Código:* \\`${tut.json.id_tutoria}\\`\\n`;\n    mensaje += `📚 *Materia:* ${tut.json.materia}\\n`;\n    mensaje += `📅 *Fecha:* ${fechaLimpia}\\n`;\n    mensaje += `⏰ *Horario:* ${tut.json.hora_inicio} - ${tut.json.hora_fin}\\n`;\n    mensaje += `--------------------------------\\n\\n`;\n  });\n}\n\n// 3. Retornamos exactamente el mismo formato de variables para los nodos subsiguientes\nreturn [{ \n  json: { \n    id_usuario: idUsuario, \n    mensaje_final: mensaje, \n    total: activas.length \n  } \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        192
      ],
