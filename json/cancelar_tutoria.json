    {
      "parameters": {
        "jsCode": "// 1. Capturamos los datos\nconst tutorias = $input.all();\nconst triggerData = $(\"When Executed by Another Workflow\").first().json;\nconst codigoIngresado = triggerData.Texto.toUpperCase().trim();\nconst idUsuario = triggerData.id_usuario;\n\n// 2. Filtramos únicamente las tutorías activas asignadas a este estudiante\nconst activas = tutorias.filter(t => \n  t.json.id_estudiante && t.json.id_estudiante.toString() === idUsuario.toString() && t.json.estado === \"Asignada\"\n);\n\n// 3. Comprobamos si el código escrito por el usuario existe en sus tutorías activas\nconst existeCodigo = activas.some(t => t.json.id_tutoria && t.json.id_tutoria.toUpperCase().trim() === codigoIngresado);\n\n// 4. Retornamos el resultado de la validación\nreturn [{\n  json: {\n    id_usuario: idUsuario,\n    codigo_ingresado: codigoIngresado,\n    es_valido: existeCodigo\n  }\n}];"
