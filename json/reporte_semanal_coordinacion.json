    {
      "parameters": {
        "jsCode": "// 1. Capturamos los datos de las tutorías que entran desde Google Sheets\nconst tutorias = $input.all();\n\nlet total = tutorias.length;\nlet asignadas = 0;\nlet canceladas = 0;\n\n// Inicializamos el contador de solicitudes para las 3 materias oficiales\nlet porMateria = {\n  \"Software\": 0,\n  \"Inglés\": 0,\n  \"Ser\": 0\n};\n\n// 2. Recorremos los registros para calcular estadísticas de forma dinámica\ntutorias.forEach(item => {\n  const t = item.json;\n  const estado = t.estado ? t.estado.toLowerCase().trim() : \"\";\n  \n  if (estado === \"asignada\") {\n    asignadas++;\n  } else if (estado === \"cancelada\") {\n    canceladas++;\n  }\n\n  const materia = t.materia;\n  if (materia && porMateria[materia] !== undefined) {\n    porMateria[materia]++;\n  }\n});\n\n// 3. Construimos un único mensaje de texto formateado con Markdown estético para Telegram\nlet mensaje = \"📊 *REPORTE SEMANAL - COORDINACIÓN ACADÉMICA* 📊\\n\\n\";\nmensaje += \"Estimada Coordinación, presentamos el consolidado métrico de actividad de TutorBot:\\n\\n\";\nmensaje += `📈 *Total de solicitudes procesadas:* ${total}\\n`;\nmensaje += `✅ *Tutorías activas (Asignadas):* ${asignadas}\\n`;\nmensaje += `🛑 *Tutorías canceladas:* ${canceladas}\\n\\n`;\nmensaje += \"📚 *Desglose de demandas por asignatura:*\\n\";\nmensaje += `🔹 *Software:* ${porMateria[\"Software\"]} solicitudes\\n`;\nmensaje += `🔹 *Inglés:* ${porMateria[\"Inglés\"]} solicitudes\\n`;\nmensaje += `🔹 *Ser:* ${porMateria[\"Ser\"]} solicitudes\\n\\n`;\nmensaje += \"🤖 _Este informe estadístico ha sido consolidado de manera automática desde la base de datos de TutorBot._\";\n\n// 4. Retornamos el resultado estructurado\nreturn [{\n  json: {\n    mensaje_reporte: mensaje,\n    total_procesado: total\n  }\n}];\n"
      },
