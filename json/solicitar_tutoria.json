    {
      "parameters": {
        "jsCode": "// 1. Capturamos todos los registros que vienen de Google Sheets\nconst items = $input.all();\n\n// 2. Inicializamos el mensaje de texto para el menú de Telegram\nlet mensaje = \"Selecciona la materia para la tutoría escribiendo el número correspondiente:\\n\\n\";\n\n// Emojis de números para dar una presentación limpia (soporta hasta 10 materias)\nconst emojisNumeros = [\"1️⃣\", \"2️⃣\", \"3️⃣\", \"4️⃣\", \"5️⃣\", \"6️⃣\", \"7️⃣\", \"8️⃣\", \"9️⃣\", \"🔟\"];\n\n// Lista para guardar las materias en el mismo orden que aparecen\nconst listaMaterias = [];\n\n// 3. Recorremos directamente la lista de entrada para numerar las materias\nitems.forEach((item, index) => {\n  const nombreMateria = item.json.materia;\n  \n  if (nombreMateria) {\n    listaMaterias.push(nombreMateria);\n    const emoji = emojisNumeros[index] || `${index + 1}.`; // Fallback a número normal si hay más de 10\n    mensaje += `${emoji} **${nombreMateria}**\\n`;\n  }\n});\n\n// 4. Devolvemos el mensaje formateado y el arreglo de materias para el enrutador\nreturn [{\n  json: {\n    mensaje_menu: mensaje,\n    materias_disponibles: listaMaterias // Ejemplo: [\"Software\", \"Inglés\", \"Ser\"]\n  }\n}];"
      },
