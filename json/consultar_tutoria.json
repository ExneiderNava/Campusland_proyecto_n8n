    {
      "parameters": {
        "jsCode": "// 1. Capturamos los datos\nconst tutores = $input.all(); // Trae el listado de tutores del nodo anterior (Get row(s) in sheet1)\nconst tutorias = $(\"Get row(s) in sheet\").all(); // Apunta al nodo real de tutorías\nconst triggerData =  $(\"When Executed by Another Workflow\").first().json;\nconst idUsuario = triggerData.id_usuario;\n\n// 2. Mapeamos los tutores en un objeto rápido (id_tutor -> Nombre)\nconst mapaTutores = {};\ntutores.forEach(t => {\n  mapaTutores[t.json.id_tutor] = t.json.nombre;\n});\n\n// 3. Filtramos y construimos el listado para el estudiante\nlet mensaje = \"\";\n// USAMOS .toString() para evitar fallos de tipo (String vs Number) al comparar IDs en JS\nconst tutoriasEstudiante = tutorias.filter(t => \n  t.json.id_estudiante && t.json.id_estudiante.toString() === idUsuario.toString() && t.json.estado === \"Asignada\"\n);\n\nif (tutoriasEstudiante.length === 0) {\n  mensaje = \"📭 **Actualmente no tienes ninguna tutoría agendada.**\\n\\n¡Anímate a solicitar tu primera asesoría desde el menú principal!\";\n} else {\n  mensaje = \"📅 *TUS TUTORÍAS PROGRAMADAS*\\n\\n\";\n  \n  tutoriasEstudiante.forEach((tut, index) => {\n    const nombreTutor = mapaTutores[tut.json.id_tutor] || \"Por asignar\";\n    \n    // Limpiamos formato de fecha si viene guardado como array de String en Sheets\n    let fechaLimpia = tut.json.fecha;\n    if (fechaLimpia && typeof fechaLimpia === 'string' && fechaLimpia.startsWith(\"[\")) {\n      try {\n        const arr = JSON.parse(fechaLimpia);\n        fechaLimpia = Array.isArray(arr) ? arr.at(0) : arr; // Extrae solo la fecha limpia del arreglo\n      } catch (e) {}\n    }\n\n    // CONSTRUIDO CON BACKTICKS CORRECTOS Y SEGUROS\n    mensaje += `🔔 *Tutoría #${index + 1}* (Ref: *${tut.json.id_tutoria}*)\\n`;\n    mensaje += `📚 *Materia:* ${tut.json.materia}\\n`;\n    mensaje += `👨‍🏫 *Tutor:* ${nombreTutor}\\n`;\n    mensaje += `📅 *Fecha:* ${fechaLimpia}\\n`;\n    mensaje += `⏰ *Horario:* ${tut.json.hora_inicio} - ${tut.json.hora_fin}\\n`;\n    mensaje += `🔗 *Aula Virtual:* ${tut.json.url_de_conexion || 'link_here'}\\n`;\n    mensaje += `--------------------------------\\n\\n`;\n  });\n}\n\n// 4. Retornamos el mensaje formateado\nreturn [{\n  json: {\n    id_usuario: idUsuario,\n    mensaje_final: mensaje\n  }\n}];\n"
      },
