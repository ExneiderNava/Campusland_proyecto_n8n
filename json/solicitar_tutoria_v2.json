    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\n// Generar código aleatorio de tutoría (TUT-XXXX)\nconst idTutoria = 'TUT-' + Math.floor(1000 + Math.random() * 9000);\n\n// Calcular la fecha del próximo Lunes de forma determinista\nconst proximoLunes = new Date(Date.now() + ((8 - new Date().getDay()) % 7 || 7) * 24 * 3600 * 1000);\nconst fechaFormateada = proximoLunes.toISOString().split('T').at(0);\n\nreturn [{\n  json: {\n    id_tutoria: idTutoria,\n    id_estudiante: body.id_estudiante,\n    id_tutor: body.id_tutor,\n    materia: body.materia,\n    fecha: fechaFormateada,\n    hora_inicio: body.hora_inicio,\n    hora_fin: body.hora_fin,\n    id_disponibilidad: body.id_disponibilidad\n  }\n}];"
      },
