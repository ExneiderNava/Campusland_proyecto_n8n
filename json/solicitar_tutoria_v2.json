    {
      "parameters": {
        "jsCode": "// 1. Extraemos los datos de Sheets y el ID del estudiante desde la URL de Telegram\nconst disponibilidades = $input.all();\nconst tutores = $(\"Leer Tutores Form\").all();\nconst idEstudiante = $(\"Webhook\").first().json.query.id_estudiante;\n\n// 2. Mapeamos los tutores oficiales para relacionar sus materias\nconst listaTutores = tutores.map(t => ({\n  id_tutor: t.json.id_tutor.toString(),\n  nombre: t.json.nombre,\n  materia: t.json.materia\n}));\n\n// 3. Mapeamos las disponibilidades libres de la base de datos\nconst listaDispo = disponibilidades.map(d => ({\n  id_disponibilidad: d.json.id_disponibilidad,\n  id_tutor: d.json.id_tutor.toString(),\n  dia_semana: d.json.dia_semana,\n  hora_inicio: d.json.hora_inicio,\n  hora_fin: d.json.hora_fin\n}));\n\n// 4. Construimos la interfaz con JavaScript embebido para el filtrado dinámico\nconst htmlContent = `\n<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>TutorBot - Solicitar Tutoría</title>\n  <style>\n    body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #f4f6f9; margin: 0; padding: 20px; display: flex; justify-content: center; align-items: center; min-height: 100vh; }\n    .card { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); width: 100%; max-width: 420px; }\n    h2 { margin-top: 0; color: #0088cc; font-size: 24px; text-align: center; }\n    p { color: #666; font-size: 13px; text-align: center; margin-bottom: 25px; line-height: 1.5; }\n    .form-group { margin-bottom: 18px; }\n    label { display: block; margin-bottom: 6px; font-weight: bold; color: #333; font-size: 13px; }\n    select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; background-color: #fff; color: #333; box-sizing: border-box; }\n    select:disabled { background-color: #eee; cursor: not-allowed; }\n    button { width: 100%; padding: 12px; background-color: #0088cc; color: white; border: none; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 10px; transition: background 0.2s; }\n    button:hover { background-color: #0077b3; }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <h2>🤖 TutorBot Agenda</h2>\n    <p>Completa los campos en orden para reservar tu tutoría. Los horarios se actualizan en tiempo real.</p>\n    \n    <form action=\"https://exneider.app.n8n.cloud/webhook/registrar-tutoria\" method=\"POST\">\n      <input type=\"hidden\" name=\"id_estudiante\" value=\"${idEstudiante}\">\n      <input type=\"hidden\" name=\"id_disponibilidad\" id=\"id_disponibilidad\">\n      <input type=\"hidden\" name=\"hora_inicio\" id=\"hora_inicio\">\n      <input type=\"hidden\" name=\"hora_fin\" id=\"hora_fin\">\n\n      <div class=\"form-group\">\n        <label for=\"materia\">1. Selecciona la Materia</label>\n        <select id=\"materia\" name=\"materia\" required onchange=\"filtrarTutores()\">\n          <option value=\"\" disabled selected>-- Elige una materia --</option>\n          <option value=\"Software\">Software</option>\n          <option value=\"Inglés\">Inglés</option>\n          <option value=\"Ser\">Ser</option>\n        </select>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"tutor\">2. Selecciona el Tutor</label>\n        <select id=\"tutor\" name=\"id_tutor\" required disabled onchange=\"filtrarHorarios()\">\n          <option value=\"\" disabled selected>-- Primero elige materia --</option>\n        </select>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"horario\">3. Selecciona el Horario</label>\n        <select id=\"horario\" name=\"horario_raw\" required disabled onchange=\"setHorarioValores()\">\n          <option value=\"\" disabled selected>-- Primero elige tutor --</option>\n        </select>\n      </div>\n\n      <button type=\"submit\">Agendar Tutoría 🎓</button>\n    </form>\n  </div>\n\n  <script>\n    // Inyección de bases de datos desde n8n\n    const tutores = ${JSON.stringify(listaTutores)};\n    const disponibilidades = ${JSON.stringify(listaDispo)};\n\n    function filtrarTutores() {\n      const materiaSel = document.getElementById(\"materia\").value;\n      const tutorSelect = document.getElementById(\"tutor\");\n      const horarioSelect = document.getElementById(\"horario\");\n      \n      tutorSelect.innerHTML = '<option value=\"\" disabled selected>-- Elige un tutor --</option>';\n      horarioSelect.innerHTML = '<option value=\"\" disabled selected>-- Primero elige tutor --</option>';\n      horarioSelect.disabled = true;\n\n      const filtrados = tutores.filter(t => t.materia === materiaSel);\n      \n      if(filtrados.length > 0) {\n        filtrados.forEach(t => {\n          tutorSelect.innerHTML += '<option value=\"' + t.id_tutor + '\">' + t.nombre + '</option>';\n        });\n        tutorSelect.disabled = false;\n      } else {\n        tutorSelect.innerHTML = '<option value=\"\" disabled selected>No hay tutores disponibles</option>';\n        tutorSelect.disabled = true;\n      }\n    }\n\n    function filtrarHorarios() {\n      const tutorSel = document.getElementById(\"tutor\").value;\n      const horarioSelect = document.getElementById(\"horario\");\n      \n      horarioSelect.innerHTML = '<option value=\"\" disabled selected>-- Elige un horario --</option>';\n\n      const filtrados = disponibilidades.filter(d => d.id_tutor === tutorSel);\n      \n      if(filtrados.length > 0) {\n        filtrados.forEach(d => {\n          const valor = JSON.stringify({id: d.id_disponibilidad, ini: d.hora_inicio, fin: d.hora_fin});\n          \n          // Formateamos el día de la semana estéticamente (Ej: \"MARTES\" -> \"Martes\")\n          const diaFormateado = d.dia_semana.charAt(0).toUpperCase() + d.dia_semana.slice(1).toLowerCase();\n          \n          // 💡 Lógica limpia con comillas dobles en JS y simples en HTML. ¡Cero caracteres de escape!\n          horarioSelect.innerHTML += \"<option value='\" + valor + \"'>📅 \" + diaFormateado + \": \" + d.hora_inicio + \" - \" + d.hora_fin + \"</option>\";\n        });\n        horarioSelect.disabled = false;\n      } else {\n        horarioSelect.innerHTML = '<option value=\"\" disabled selected>Sin horarios libres</option>';\n        horarioSelect.disabled = true;\n      }\n    }\n\n    function setHorarioValores() {\n      const rawVal = document.getElementById(\"horario\").value;\n      if (rawVal) {\n        const parsed = JSON.parse(rawVal);\n        document.getElementById(\"id_disponibilidad\").value = parsed.id;\n        document.getElementById(\"hora_inicio\").value = parsed.ini;\n        document.getElementById(\"hora_fin\").value = parsed.fin;\n      }\n    }\n  </script>\n</body>\n</html>\n`;\n\nreturn [{ json: { html: htmlContent } }];"
      },
